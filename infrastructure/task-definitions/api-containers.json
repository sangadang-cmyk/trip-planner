[
  {
    "name": "trip-api",
    "image": "public.ecr.aws/docker/library/nginx:latest",
    "cpu": 1024,
    "memory": 3072,
    "memoryReservation": 2048,
    "essential": true,
    "portMappings": [
      {
        "containerPort": 80,
        "hostPort": 80,
        "protocol": "tcp",
        "name": "main-api-port",
        "appProtocol": "http"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/trip-dev-api",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "ecs"
      }
    }
  }
]